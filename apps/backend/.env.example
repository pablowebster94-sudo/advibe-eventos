# Ruta del SQLite, relativa a apps/backend/prisma/ (solo la usa el CLI de Prisma, ej. db:push)
DATABASE_URL="file:../../../data/advibe.db"
# Ruta absoluta del archivo SQLite que usa la app en runtime (lib/database.ts).
# Acepta DATABASE_PATH o DB_PATH; si no se define cae a process.cwd()/../../data/advibe.db.
# En Railway: apuntar al volumen persistente, ej. /data/advibe.db
DB_PATH="/data/advibe.db"
# Dónde se guardan los JPG procesados. Relativa a apps/backend/ en local,
# absoluta en producción (dentro del volumen), ej. /data/media
DATA_DIR="/data/media"
# URL con la que se arman la galería y el QR del evento. En producción, el dominio público de Railway.
PUBLIC_BASE_URL="https://TU-BACKEND.up.railway.app"
# Credencial para crear eventos desde /nuevo y POST /api/events. Sin esto, la creación queda cerrada.
ADMIN_TOKEN=""
# Origen de producción de la PWA de captura (CORS).
ALLOWED_ORIGINS="https://TU-CAPTURE.up.railway.app"
# Puerto del servidor Next. Railway lo inyecta solo; en local cae a 3300.
PORT=3300
