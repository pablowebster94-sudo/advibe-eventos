# Ruta del SQLite, relativa a apps/backend/prisma/ (solo la usa el CLI de Prisma, ej. db:push)
DATABASE_URL="file:../../../data/advibe.db"
# Ruta absoluta del archivo SQLite que usa la app en runtime (lib/database.ts).
# Si no se define, cae a process.cwd()/../../data/advibe.db (para desarrollo local).
# En Railway: apuntar al volumen persistente, ej. /data/advibe.db
DB_PATH=""
# Dónde se guardan los JPG procesados, relativa a apps/backend/ (o absoluta en producción, ej. /data/media)
DATA_DIR="../../data/media"
# URL con la que se arma el QR del evento. En producción, el dominio público de Railway.
PUBLIC_BASE_URL="http://localhost:3300"
# Puerto del servidor Next. Railway lo inyecta solo; en local cae a 3300.
PORT=3300
