# Ruta del SQLite, relativa a apps/backend/prisma/
DATABASE_URL="file:../../../data/advibe.db"
# Dónde se guardan los JPG procesados, relativa a apps/backend/
DATA_DIR="../../data/media"
# URL con la que se arma el QR del evento. En producción, el dominio público.
PUBLIC_BASE_URL="http://localhost:3300"
# Credencial para crear eventos desde /nuevo y POST /api/events.
# Sin este valor la creación de eventos queda cerrada (503).
ADMIN_TOKEN=""
