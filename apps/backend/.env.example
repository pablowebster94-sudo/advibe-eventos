# Persistent SQLite database path. On Railway mount the volume at /app/data.
DATABASE_PATH="/app/data/advibe.db"
# Processed JPGs and thumbnails.
DATA_DIR="/app/data/media"
# Public URL of the backend, used for gallery and QR links.
PUBLIC_BASE_URL="https://TU-BACKEND.up.railway.app"
# Required to create events from /nuevo and POST /api/events.
ADMIN_TOKEN=""
# Production origin of the capture PWA.
ALLOWED_ORIGINS="https://TU-CAPTURE.up.railway.app"
